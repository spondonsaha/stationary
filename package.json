{
  "name": "stationery-shop",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready stationery shop with full invoice system",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "test:checkout": "tsx scripts/smoke-checkout.ts",
    "db:reset": "drizzle-kit drop && npm run db:migrate && npm run db:seed",
    "images:generate": "node scripts/generate-product-images.mjs",
    "pdf:sample": "node --env-file=.env scripts/fetch-sample-invoice.mjs"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.3.0",
    "drizzle-orm": "^0.44.2",
    "next": "^15.5.4",
    "postgres": "^3.4.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.1",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.5.4",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
