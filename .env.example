# --- Database ---
# PostgreSQL connection string. For pooled/serverless setups point this at
# PgBouncer and add ?prepare=false (postgres.js supports it via URL params).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stationery

# --- Auth ---
# 32+ random bytes, e.g. `openssl rand -hex 32` (or `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).
AUTH_SECRET=change-me-to-a-long-random-string

# --- Institutional branding ---
UNIVERSITY_NAME=Northgate University
STORE_NAME=University Bookstore
STORE_TAGLINE=Textbooks, supplies & campus essentials
STORE_EMAIL=bookstore@northgate.edu
STORE_PHONE=+1 (555) 010-2030
STORE_ADDRESS=Student Union Building, Ground Floor, Northgate University
STORE_HOURS=Monâ€“Fri 8:00â€“18:00 Â· Sat 10:00â€“16:00

# --- Money ---
# ISO 4217 currency code
CURRENCY=BDT

# --- App ---
# Public base URL used in invoice links
NEXT_PUBLIC_URL=http://localhost:3000

# --- Images (Cloudinary, optional) ---
# When set, admin-uploaded product/category images are stored on Cloudinary
# instead of the local /public/uploads folder (recommended for production â€”
# files survive redeploys and are CDN-served). Format:
#   cloudinary://<api_key>:<api_secret>@<cloud_name>
# Leave empty to fall back to local /public/uploads.
CLOUDINARY_URL=
# Optional: prefix folder in your Cloudinary media library, e.g. stationery
CLOUDINARY_FOLDER=

# --- Seed admin (optional) ---
# Password for the seeded admin account. If unset, the seed script generates a
# strong random password and prints it once â€” never committed to the repo.
SEED_ADMIN_PASSWORD=
